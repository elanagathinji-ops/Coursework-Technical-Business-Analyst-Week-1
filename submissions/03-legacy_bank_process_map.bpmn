<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1rtz0du" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_0e9loob">
    <bpmn:participant id="Participant_0u0r6pu" processRef="Process_0eww5qp" />
    <bpmn:textAnnotation id="TextAnnotation_1698sh2">
      <bpmn:text>If account is not updated accurately then might be wrongly included/excluded from report</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_02dsw96">
      <bpmn:text>Representatives assign different status codes in local tracking sheets, leaving the central 20-year-old database showing outdated or inaccurate account states</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0q0gsu8">
      <bpmn:text>Representatives waste time searching through spreadsheets and email threads to reconstruct prior agent notes before dialing a customer.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0z351is">
      <bpmn:text>Due to a lack of real-time contact logging, agents on shift make duplicate calls to customers, violating contact frequency policies and prompting complaints</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1r7gj0p">
      <bpmn:text>Representatives spend a large portion of time manually duplicating call outcome logs across three different un-synced systems</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_16z6lsq">
      <bpmn:text>Manually updating records is time consuming and can create discrepancies between sources</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1qo003k">
      <bpmn:text>When an agent misses setting a manual temporary hold flag, the system re-issues the account into the daily dial list, triggering unwanted chasing calls to customers who already set up payment terms</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ci9wil">
      <bpmn:text>The legacy database lacks automated payment-clearing alerts, forcing agents remember to manually cross-check logs for  promised dates</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1p01x8r">
      <bpmn:text>poor visibility of promise-to-pay fulfilment</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1nnkwj1">
      <bpmn:text>Details must be manually updated across multiple sources which wastes time and can create discrepancies</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_185dg0h">
      <bpmn:text>If an agent forgets to follow up then broken arrangements slip through the cracks</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0v9plnu">
      <bpmn:text>Waiting for a customer to answer is time consuming. It could take hours to get a response</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1bqh8ng" associationDirection="None" sourceRef="Activity_1o0t357" targetRef="TextAnnotation_1698sh2" />
    <bpmn:association id="Association_0a5wfew" associationDirection="None" sourceRef="TextAnnotation_1698sh2" targetRef="DataObjectReference_0yfqanz" />
    <bpmn:association id="Association_1bo7nt1" associationDirection="None" sourceRef="Gateway_1t01vsm" targetRef="TextAnnotation_0v9plnu" />
